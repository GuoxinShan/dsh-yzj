{
  "name": "@dsh-yzj/robot-yzj",
  "description": "Yunzhijia robot channel host plugin: measured WebSocket inbound, sendMsgUrl outbound, per-DM agent sessions with reply-chain continuation and bang commands",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@dsh-yzj/bridge": "workspace:^",
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-llm": "link:../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-schedule": "link:../../../deepseek-harness/packages/schedule/schedule",
    "@deepseek-ai/dsh-storage-domain": "link:../../../deepseek-harness/packages/storage/storage-domain",
    "@deepseek-ai/dsh-tools": "link:../../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness/vendor/schemastery",
    "zod": "^4.4.3"
  }
}
